====================================================
ملف Dockerfile
====================================================

أنشئ ملف باسم:
Dockerfile

وضع داخله:

FROM node:20

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]

====================================================
ملف docker-compose.yml
====================================================

أنشئ ملف باسم:
docker-compose.yml

وضع داخله:

version: '3'

services:
  fleet-system:
    build: .
    ports:
      - "5173:5173"
    volumes:
      - .:/app
      - /app/node_modules

